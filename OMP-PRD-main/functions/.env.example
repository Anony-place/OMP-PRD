# Firebase Functions environment (copy to .env for the emulator only —
# never commit a filled-in .env; it is covered by .gitignore).
#
# In production set these with:
#   firebase functions:config:set sitemap.edge_url="https://<ref>.supabase.co/functions/v1/sitemap"
# or as real environment variables (functions.config() is legacy on 2nd gen).

# Where the dynamic sitemap actually comes from (Supabase Edge Function).
SITEMAP_EDGE_URL=https://aeehfulikupskyrvcpzb.supabase.co/functions/v1/sitemap

# Public site origin used to build absolute <loc> URLs. No trailing slash.
SITE_ORIGIN=https://oopsmypassword.web.app

# lastmod stamped on the static routes that only change when the site is rebuilt.
STATIC_LASTMOD=2026-08-23

# Supabase project (publishable key only — never the service-role key).
SUPABASE_URL=https://aeehfulikupskyrvcpzb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_s3n2U32MNB4PvHx0GolyqA_wlkzD6eR
