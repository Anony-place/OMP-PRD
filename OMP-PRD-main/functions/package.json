{
  "name": "omp-functions",
  "version": "1.0.0",
  "description": "OMP Firebase Cloud Functions",
  "main": "index.js",
  "scripts": {
    "sync:sitemap": "node sync-sitemap-core.js",
    "predeploy": "npm run sync:sitemap",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "sanitize-html": "2.17.7"
  },
  "private": true,
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
