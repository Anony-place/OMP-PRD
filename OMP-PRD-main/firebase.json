{
  "hosting": {
    "site": "oopsmypassword",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "supabase/**",
      "functions/**",
      "scripts/**",
      "**/*.md",
      "**/__pycache__/**",
      "package.json",
      "package-lock.json"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "regex": "/(.*)\\.html",
        "destination": "https://oopsmypassword.vercel.app/:1",
        "type": 301
      },
      {
        "regex": "/(.*)",
        "destination": "https://oopsmypassword.vercel.app/:1",
        "type": 301
      },
      {
        "source": "/blog.html",
        "destination": "/articles",
        "type": 301
      },
      {
        "source": "/blog",
        "destination": "/articles",
        "type": 301
      },
      {
        "source": "/guides.html",
        "destination": "/articles",
        "type": 301
      },
      {
        "source": "/guides",
        "destination": "/articles",
        "type": 301
      },
      {
        "regex": "/guides/(.*)\\.html",
        "destination": "/articles/:1",
        "type": 301
      },
      {
        "regex": "/guides/(.+)",
        "destination": "/articles/:1",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/articles/create-strong-password",
        "destination": "/guides/create-strong-password.html"
