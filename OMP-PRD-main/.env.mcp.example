# Supabase MCP server configuration
# Copy this file to .env.mcp and fill in your values.
# .env.mcp is gitignored — never commit secrets.

# Personal Access Token (PAT) for the Supabase Management API.
# Create one at: https://supabase.com/dashboard/account/access-tokens
# This is NOT the service_role key — it's a PAT for the Management API.
SUPABASE_ACCESS_TOKEN=

# Supabase project ref (the OMP Academy project).
# Usually passed via --project-ref, but can be set here too.
SUPABASE_PROJECT_REF=aeehfulikupskyrvcpzb

# Supabase project URL.
SUPABASE_URL=https://aeehfulikupskyrvcpzb.supabase.co

# Optional: override the Supabase Management API URL (rarely needed).
# SUPABASE_API_URL=https://api.supabase.com

# Optional: explicit content API URL (defaults to SUPABASE_URL above).
# SUPABASE_CONTENT_API_URL=https://aeehfulikupskyrvcpzb.supabase.co
